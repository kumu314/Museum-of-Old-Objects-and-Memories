# 本地配置样例：复制为 .env.local 后填入真实值。
# 这个文件本身不含任何密钥，可以提交；.env.local 不能提交。

# 以下是 compose.yaml 的本地专用凭据，不用于生产；两个库在独立容器内。
DATABASE_URL=postgresql://shiwuguan_dev:local_dev_only@127.0.0.1:55432/shiwuguan_dev

# 测试库：必须是另一个数据库，自动化测试只连这里
TEST_DATABASE_URL=postgresql://shiwuguan_test:local_test_only@127.0.0.1:55433/shiwuguan_test
