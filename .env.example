# Copy only when .env.local does not exist; never commit real values.
# pnpm db:local generates isolated PostgreSQL 18 databases and local credentials.
DATABASE_URL=postgresql://app:replace-me@127.0.0.1:15432/shiwuguan
TEST_DATABASE_URL=postgresql://app_test:replace-me@127.0.0.1:15433/shiwuguan
SESSION_PASSWORD=replace-with-at-least-32-random-characters
APP_ORIGIN=http://127.0.0.1:17682
# Absolute persistent directory outside public/. Production requires HTTPS origin.
UPLOAD_DIR=/absolute/path/to/private/uploads
# G4 is unavailable until explicitly configured; no fake successful AI responses.
# AI_BASE_URL=
# AI_MODEL=
# AI_API_KEY=
# For pnpm team:create only; remove TEAM_PASSWORD after provisioning.
# TEAM_USERNAME=
# TEAM_PASSWORD=
# account source label only (member | user); it never grants permissions.
# TEAM_ROLE=
# Username + password self-registration is on by default; set closed to disable the endpoint.
# SELF_REGISTRATION=open
# Photo-to-3D demo path: local hunyuan3d-proxy (reverse proxy). Start the proxy
# and log in before using generation; never expose the proxy to the public internet.
# HUNYUAN_PROXY_BASE_URL=http://127.0.0.1:8812
# Official Tencent Cloud Hunyuan 3D Pro (production path). When all three are
# set, generation uses the cloud API instead of the local reverse proxy.
# HUNYUAN_SECRET_ID=
# HUNYUAN_SECRET_KEY=
# HUNYUAN_REGION=ap-guangzhou
# HUNYUAN_3D_MODEL=3.1

# 可选：锁定生成通道 cloud 或 proxy；JSON 配置中的 provider 优先。
# HUNYUAN_PROVIDER=cloud
# 可选：覆盖默认 .local/model-provider.json 路径，仅服务端读取。
# HUNYUAN_PROVIDER_CONFIG=
